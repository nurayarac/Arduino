    else if (request.indexOf("/right") != -1) {
      Serial.println("➡ Sağa dönüyor!");
      hareket(HIGH, LOW, LOW, HIGH, 150);
    } 
    else if (request.indexOf("/stop") != -1) {
      Serial.println("⏹ Durduruluyor!");
      hareket(LOW, LOW, LOW, LOW, 0);
    }

