#include <WiFi.h>

int IN4 = D0;
int IN3 = D1;
int IN1 = D12;
int IN2 = D13;
int ENApin = D8;
int ENBpin = D14;

const char *ssid = "ESP32_Car";
const char *password = "87654321";

WiFiServer server(80);

void setup() {
  Serial.begin(115200);
  pinMode(IN4, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENApin, OUTPUT);
  pinMode(ENBpin, OUTPUT);

  WiFi.softAP(ssid, password);
  Serial.println("Wi-Fi Ağı Oluşturuldu!");
  Serial.print("ESP32 IP Adresi: ");
  Serial.println(WiFi.softAPIP());

  server.begin();
}

void hareket(int sag, int sag_geri, int sol, int sol_geri, int hiz) {
  digitalWrite(IN4, sag);
  digitalWrite(IN3, sag_geri);
  digitalWrite(IN1, sol);
  digitalWrite(IN2, sol_geri);
  analogWrite(ENApin, hiz);
  analogWrite(ENBpin, hiz);
}

void loop() {
  WiFiClient client = server.available();
  
  if (client) {
    String request = client.readStringUntil('\r');
    Serial.println(request);
    client.flush();

    
    if (request.indexOf("/forward") != -1) {
      Serial.println("🚗 İleri gidiyor!");
